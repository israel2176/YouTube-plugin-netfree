{
  "manifest_version": 3,
  "name": "Ongoing YouTube transition for NF",
  "version": "2.0",
  "description": "Replace a YouTube video blocked by Netfree, with another open video",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"] }],
  "options_page": "HTML/options.html",
  "action": { "default_popup": "HTML/options.html" }
}
